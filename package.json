{
  "name": "watchtower",
  "version": "1.0.0",
  "description": "Watchtower — production-ready cybersecurity asset-monitoring Telegram bot for Cloudflare Workers",
  "main": "src/index.ts",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "wrangler d1 migrations apply watchtower-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply watchtower-db --remote",
    "db:seed": "wrangler d1 execute watchtower-db --local --file=migrations/0001_init.sql",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'"
  },
  "dependencies": {
    "csv-stringify": "^6.5.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240924.0",
    "@types/node": "^20.16.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.78.0",
    "@vitest/coverage-v8": "^2.1.0"
  },
  "keywords": [
    "cloudflare-workers",
    "telegram-bot",
    "security",
    "asset-monitoring",
    "reconnaissance",
    "bug-bounty",
    "subdomain-monitoring",
    "vulnerability-management"
  ],
  "license": "Apache-2.0"
}
