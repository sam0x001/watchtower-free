# Watchtower — Environment Variable Template
# ---------------------------------------------------------------------------
# Copy to `.dev.vars` for `wrangler dev` or set in Cloudflare dashboard.
# Secrets MUST be set via `wrangler secret put <NAME>` — never commit them.
# ---------------------------------------------------------------------------

# ---- Telegram ------------------------------------------------------------
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
TELEGRAM_WEBHOOK_SECRET="a-random-64-char-hex-string"
# Comma-separated allowlist of Telegram user IDs permitted to bootstrap the bot
AUTHORIZED_TELEGRAM_IDS="111111111,222222222"

# ---- Crypto -------------------------------------------------------------
# 32 bytes base64 — used for AES-GCM at-rest encryption of sensitive fields.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="base64:REPLACE_WITH_32_RANDOM_BYTES"

# HMAC key used to sign API tokens, callback URLs, runner job payloads, etc.
API_HMAC_KEY="another-random-64-char-hex-string"

# Random 32-byte value used to salt secret fingerprints. Without this, a
# leaked fingerprint could be brute-forced offline against a small keyspace.
# Generate with: openssl rand -hex 32
REDACTION_SALT="another-random-64-char-hex-string"

# Signs incoming/outgoing webhooks (Slack, Jira, GitHub, generic).
WEBHOOK_SIGNING_SECRET="another-random-64-char-hex-string"

# ---- External Scanner Runner --------------------------------------------
# Token the bot uses to authenticate against the external runner registry.
RUNNER_REGISTRY_TOKEN="long-random-string"

# ---- Optional Integrations ----------------------------------------------
# SLACK_BOT_TOKEN="xoxb-..."
# JIRA_API_TOKEN="..."
# JIRA_BASE_URL="https://yourorg.atlassian.net"
# GITHUB_TOKEN="ghp_..."
# GITHUB_REPO="yourorg/watchtower-reports"
# SENDGRID_API_KEY="SG...."
# SENDGRID_FROM="watchtower@yourdomain.com"
# OSV_API_KEY=""
# NVD_API_KEY=""

# ---- Optional Runtime Overrides -----------------------------------------
# LOG_LEVEL="debug|info|warn|error"
# DEFAULT_MAX_CONCURRENT_SCANS="5"
# DEFAULT_RATE_LIMIT_PER_MINUTE="60"
